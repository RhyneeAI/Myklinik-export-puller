# ─── Target ─────────────────────────────────────────────
APP_TARGET=MyPharma
ENDPOINT_URL=https://apps.myklinik.id/

# ─── Output ─────────────────────────────────────────────
OUTPUT_DIR=output

# ─── Date Range (START must be newer than END) ──────────
START_DATE=2026-07
END_DATE=2023-01

# ─── Cookies (from browser devtools) ────────────────────
# Option A: paste all cookies as JSON (right-click cookies table → Copy as JSON)
# COOKIES_JSON=[{"name":"SERVERID","value":"s31",...},...]

# Option B: individual cookie values (isi dengan nilai dari browser)
SERVERID=
SOKKACREATIVEID=
TOKEN=
SESSION_NAME=
SESSION_VALUE=
KEY1=
KEY2=
KEY3=
KEY4=

# ─── Mode: pendaftaran | kunjungan | all ────────────────
MODE=all

# ─── Delay between requests (ms) ────────────────────────
REQUEST_DELAY_MS=15000

# ─── Max retries on error ───────────────────────────────
MAX_RETRIES=3
