# ─── Target ─────────────────────────────────────────────
APP_TARGET=MyPharma
ENDPOINT_URL=https://apps.myklinik.id/

# ─── Output ─────────────────────────────────────────────
OUTPUT_DIR=output

# ─── Date Range (START must be newer than END) ──────────
START_DATE=2026-07
END_DATE=2023-01

# ─── Cookies (from browser devtools) ────────────────────
SERVEID=your_serveid_value_here
SOKKACREATIVEID=your_sokkacreativeid_value_here
TOKEN=your_token_value_here

# ─── Mode: pendaftaran | kunjungan | all ────────────────
MODE=all

# ─── Delay between requests (ms) ────────────────────────
REQUEST_DELAY_MS=15000

# ─── Max retries on error ───────────────────────────────
MAX_RETRIES=3
