# ─── Target ─────────────────────────────────────────────
APP_TARGET=MyPharma
ENDPOINT_URL=https://apps.myklinik.id/

# ─── Output ─────────────────────────────────────────────
OUTPUT_DIR=output

# ─── Date Range (START must be newer than END) ──────────
START_DATE=2026-07
END_DATE=2023-01

# ─── Authentication ─────────────────────────────────────
# Option A (recommended): auto-login with credentials
LOGIN_KEY=your_6digit_login_key
LOGIN_USER=your_username
LOGIN_PASS=your_password

# Option B: cookies from browser (fallback if no login credentials)
# COOKIES_JSON=[{"name":"SERVERID","value":"...",...},...]
# SERVERID=
# SOKKACREATIVEID=
# TOKEN=
# SESSION_NAME=
# SESSION_VALUE=
# KEY1=
# KEY2=
# KEY3=
# KEY4=

# ─── Mode: pendaftaran | kunjungan | all ────────────────
MODE=all

# ─── Delay between requests (ms) ────────────────────────
REQUEST_DELAY_MS=15000

# ─── Max retries on error ───────────────────────────────
MAX_RETRIES=3
