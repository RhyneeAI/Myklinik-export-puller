# ─── Target ─────────────────────────────────────────────
APP_TARGET=MyPharma
ENDPOINT_URL=https://apps.myklinik.id/

# ─── Output ─────────────────────────────────────────────
OUTPUT_DIR=output

# ─── Date Range (START must be newer than END) ──────────
START_DATE=2026-07
END_DATE=2023-01

# ─── Cookies (from browser devtools) ────────────────────
# Option A: paste all cookies as JSON (right-click cookies table → Copy as JSON)
# COOKIES_JSON=[{"name":"SERVERID","value":"s31",...},...]

# Option B: individual cookie values (fill all that apply)
SERVERID=s31
SOKKACREATIVEID=your_sokkacreativeid_value_here
TOKEN=your_token_value_here
SESSION_NAME=jPncgpun2J53LGzrqvfl
SESSION_VALUE=MQ%3D%3D
KEY1=your_key1_here
KEY2=your_key2_here
KEY3=your_key3_here
KEY4=your_key4_here

# ─── Mode: pendaftaran | kunjungan | all ────────────────
MODE=all

# ─── Delay between requests (ms) ────────────────────────
REQUEST_DELAY_MS=15000

# ─── Max retries on error ───────────────────────────────
MAX_RETRIES=3
